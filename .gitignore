# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── Virtual environments ────────────────────────────────────────────────
.venv/
venv/
env/
.python-version

# ── Test & coverage artifacts ───────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Environment / secrets ───────────────────────────────────────────────
# Never commit real .env files; keep .env.example tracked if you add one.
.env
.env.*
!.env.example

# ── OS clutter ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors / IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Build / package artifacts ───────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ── Project-specific ────────────────────────────────────────────────────
# Generated DOCX / PDF samples from test_convert.py
testing-docs/

# Local-only LibreOffice temp / lock files if you ever run it outside Docker
.~lock.*
