# Copy this file to .env and edit per your VPS sizing:
#   cp .env.example .env
#
# Docker Compose auto-loads .env from this directory — no --env-file flag needed.
# After editing .env, redeploy with:
#   docker compose up -d
#
# (.env is gitignored; .env.example is checked in as the template.)

# ── Worker pool size ──────────────────────────────────────────────────────
# Max concurrent conversions (asyncio.Semaphore limit inside the process).
# Set to roughly 1.5x vCPUs — see the sizing table below.
CONVERT_MAX_WORKERS=3

# ── Container memory cap ──────────────────────────────────────────────────
# Hard limit on the converter container. Leave ~1 GB for host OS overhead.
# LibreOffice peaks at 100-300 MB per PDF conversion, so the cap needs to
# comfortably fit CONVERT_MAX_WORKERS simultaneous conversions.
MEMORY_LIMIT=3G

# ── Sizing guide ──────────────────────────────────────────────────────────
# (from SETUP.md — keep these in sync)
#
# | VPS spec        | CONVERT_MAX_WORKERS | MEMORY_LIMIT | DOCX/min | PDF/min |
# |-----------------|---------------------|--------------|----------|---------|
# | 1 vCPU /  2 GB  | 2                   | 1500M        | ~30      | ~10     |
# | 2 vCPU /  4 GB  | 3                   | 3G           | ~60      | ~20     |
# | 4 vCPU /  8 GB  | 6                   | 7G           | ~100     | ~40     |
# | 8 vCPU / 16 GB  | 12                  | 15G          | ~200     | ~80     |
