# Copy this file to .env and edit per your VPS sizing:
#   cp .env.example .env
#
# Docker Compose auto-loads .env from this directory — no --env-file flag needed.
# After editing .env, redeploy with:
#   docker compose up -d
#
# (.env is gitignored; .env.example is checked in as the template.)

# ── Worker pool size ──────────────────────────────────────────────────────
# Conversions at once. Each worker builds documents in its own process and
# keeps a LibreOffice running, so set it to the vCPUs the converter may use:
# more workers than CPUs is slower, not faster.
CONVERT_MAX_WORKERS=3

# ── Container memory cap ──────────────────────────────────────────────────
# About 0.5 GB plus 0.5 GB per worker. Each worker's LibreOffice holds
# 150-300 MB, more after image-heavy documents, until it's restarted.
MEMORY_LIMIT=2G

# ── Sizing guide ──────────────────────────────────────────────────────────
# (from SETUP.md — keep these in sync)
#
# | Converter's vCPUs | CONVERT_MAX_WORKERS | MEMORY_LIMIT | PDF/s, older CPU | PDF/s, current CPU |
# |-------------------|---------------------|--------------|------------------|--------------------|
# | 1                 | 1                   | 1G           | ~1               | ~3                 |
# | 2                 | 2                   | 1500M        | ~2               | ~6                 |
# | 3                 | 3                   | 2G           | ~3               | ~8                 |
# | 4                 | 4                   | 2500M        | ~4               | ~10                |

# IP address of the IP 
VPC_BIND_IP="10.8.96.3"